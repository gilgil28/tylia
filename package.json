{
  "name": "tylia",
  "productName": "Tylia",
  "private": true,
  "version": "0.1.0",
  "description": "A calm, fast desktop Git client",
  "license": "MIT OR Apache-2.0",
  "homepage": "https://tylia.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tylia-dev/tylia.git"
  },
  "bugs": {
    "url": "https://github.com/tylia-dev/tylia/issues"
  },
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prepare": "node scripts/conventions.ts install-hooks",
    "dev": "vite",
    "dev:web": "vite --mode web",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "shots": "playwright test",
    "i18n:audit": "node scripts/i18n-audit.ts",
    "contrast": "node scripts/contrast.ts",
    "conventions": "node scripts/conventions.ts",
    "fixture": "node scripts/make-fixture.ts",
    "gen:types": "cargo test --workspace export_bindings"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@tanstack/react-query": "5.104.4",
    "@tanstack/react-virtual": "3.14.21",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.3",
    "@tauri-apps/plugin-opener": "2.7.2",
    "lucide-react": "1.59.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shiki": "4.5.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.12.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
